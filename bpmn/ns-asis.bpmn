<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_NS_AsIs" targetNamespace="http://rostrud.gov.ru/bpmn" exporter="Camunda Modeler" exporterVersion="5.27.0">
  <bpmn:collaboration id="Collab_AsIs">
    <bpmn:participant id="Pool_Employer" name="РАБОТОДАТЕЛЬ (бумажный процесс)" processRef="Proc_Employer" />
    <bpmn:participant id="Pool_GIT" name="ГИТ / АСУ КНД (процесс РНС — &#62;30 шагов, контроль сроков)" processRef="Proc_GIT" />
    <bpmn:participant id="Pool_External" name="ВНЕШНИЕ УЧАСТНИКИ" processRef="Proc_External" />
    <bpmn:messageFlow id="MF_Notice" name="📄 бумажное извещение&#10;(почта/факс) или email" sourceRef="Task_PaperNotice" targetRef="Evt_FromEmployer" />
    <bpmn:messageFlow id="MF_Inspector" name="письмо об инспекторе" sourceRef="Task_RNSProcess" targetRef="Task_CreateCommission" />
    <bpmn:messageFlow id="MF_Signatures" name="📄 бумажные подписи" sourceRef="Task_CollectSignatures" targetRef="Task_RNSProcess" />
    <bpmn:messageFlow id="MF_ActToASU" name="📄 файл акта Н-1" sourceRef="Task_EmployerAct" targetRef="Task_LoadAct" />
    <bpmn:messageFlow id="MF_ToSFR" name="📄 вручную (не СМЭВ)" sourceRef="Task_TransferSFR" targetRef="Task_SFR" />
    <bpmn:messageFlow id="MF_Ext_Med" sourceRef="Activity_0ktty50" targetRef="Evt_FromExternal" />
    <bpmn:messageFlow id="MF_Ext_Unions" sourceRef="Task_Unions" targetRef="Evt_FromExternal" />
    <bpmn:messageFlow id="MF_Ext_Invest" sourceRef="Activity_07soqnp" targetRef="Evt_FromExternal" />
    <bpmn:messageFlow id="MF_Ext_SMI" sourceRef="Task_SMI" targetRef="Evt_FromExternal" />
    <bpmn:messageFlow id="MF_Ext_MChS" sourceRef="Task_MChS" targetRef="Evt_FromExternal" />
    <bpmn:textAnnotation id="Ann_Mail">
      <bpmn:text>✋ Почта идёт до 2 недель.
Нет единого электронного канала.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Mail" sourceRef="Task_PaperNotice" targetRef="Ann_Mail" />
    <bpmn:textAnnotation id="Ann_Auto">
      <bpmn:text>✅ Автоматизировано в АСУ КНД:
контроль сроков (оповещения за 3, 1, 0 дн.),
формирование документов, связь с КНМ и АП</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Auto" sourceRef="Task_RNSProcess" targetRef="Ann_Auto" />
    <bpmn:textAnnotation id="Ann_Signatures">
      <bpmn:text>✋ Физическое присутствие.
Нет ЭП.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Sign" sourceRef="Task_CollectSignatures" targetRef="Ann_Signatures" />
    <bpmn:textAnnotation id="Ann_Sources">
      <bpmn:text>✋ Источники о сокрытых НС —
бумага, телефон, email. Нет СМЭВ-интеграции</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="Proc_Employer" isExecutable="false">
    <bpmn:startEvent id="Start_NS" name="Несчастный&#10;случай" />
    <bpmn:manualTask id="Task_PaperNotice" name="Бумажное&#10;извещение&#10;(email / факс / почта /&#10;нарочно)" />
    <bpmn:manualTask id="Task_CreateCommission" name="Формирование&#10;комиссии&#10;(бумажный&#10;приказ)" />
    <bpmn:manualTask id="Task_CollectSignatures" name="Сбор подписей&#10;членов комиссии&#10;(физич. присутствие)" />
    <bpmn:manualTask id="Task_EmployerAct" name="Акт о расследовании + Н-1 (бумажный,&#10;неструктурир.)" />
    <bpmn:sequenceFlow id="SF_E1" sourceRef="Start_NS" targetRef="Task_PaperNotice" />
    <bpmn:sequenceFlow id="SF_E2" sourceRef="Task_PaperNotice" targetRef="Task_CreateCommission" />
    <bpmn:sequenceFlow id="SF_E3" sourceRef="Task_CreateCommission" targetRef="Task_CollectSignatures" />
    <bpmn:sequenceFlow id="SF_E4" sourceRef="Task_CollectSignatures" targetRef="Task_EmployerAct" />
  </bpmn:process>
  <bpmn:process id="Proc_GIT" isExecutable="false">
    <bpmn:startEvent id="Evt_FromEmployer" name="От&#10;работодателя">
      <bpmn:messageEventDefinition id="MED_Employer" />
    </bpmn:startEvent>
    <bpmn:startEvent id="Evt_FromExternal" name="Из внешних&#10;источников">
      <bpmn:messageEventDefinition id="MED_External" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="GW_MergeIn" name="" />
    <bpmn:sequenceFlow id="SF_FromEmpl" sourceRef="Evt_FromEmployer" targetRef="GW_MergeIn" />
    <bpmn:sequenceFlow id="SF_FromExt" sourceRef="Evt_FromExternal" targetRef="GW_MergeIn" />
    <bpmn:sequenceFlow id="SF_MergeToInput" sourceRef="GW_MergeIn" targetRef="Task_InputNS" />
    <bpmn:userTask id="Task_InputNS" name="Ввод данных о НС&#10;в АСУ КНД" />
    <bpmn:subProcess id="Task_RNSProcess" name="Процесс РНС в АСУ КНД&#10;&#62;30 шагов · контроль сроков · документы · протоколы · АП">
      <bpmn:documentation>Включает: назначение инспектора, решение о расследовании, осмотр, протоколы опроса, запросы в СМЭ, привлечение ФОИВ, продление сроков, заключение инспектора, предписание работодателю, возбуждение дела об АП</bpmn:documentation>
    </bpmn:subProcess>
    <bpmn:userTask id="Task_LoadAct" name="Загрузка акта о расследовании&#10;и акта Н-1&#10;(файл, не структурир.)" />
    <bpmn:manualTask id="Task_TransferSFR" name="Передача&#10;данных в СФР&#10;(вручную,&#10;не через СМЭВ)" />
    <bpmn:endEvent id="End_GIT" name="" />
    <bpmn:sequenceFlow id="SF_G1" sourceRef="Task_InputNS" targetRef="Task_RNSProcess" />
    <bpmn:sequenceFlow id="SF_G2" sourceRef="Task_RNSProcess" targetRef="Task_LoadAct" />
    <bpmn:sequenceFlow id="SF_G3" sourceRef="Task_LoadAct" targetRef="Task_TransferSFR" />
    <bpmn:sequenceFlow id="SF_G4" sourceRef="Task_TransferSFR" targetRef="End_GIT" />
    <bpmn:textAnnotation id="Ann_Act">
      <bpmn:text>✋ Файл, не структурированный.
Нельзя автоматически проверить соответствие приказу Минтруда</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Act" sourceRef="Task_LoadAct" targetRef="Ann_Act" />
    <bpmn:textAnnotation id="Ann_SFR">
      <bpmn:text>✋ Нет СМЭВ-интеграции
с СФР. Ручная передача.
Нет единой статистики</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_SFR" sourceRef="Task_TransferSFR" targetRef="Ann_SFR" />
  </bpmn:process>
  <bpmn:process id="Proc_External" isExecutable="false">
    <bpmn:task id="Task_SFR" name="СФР&#10;(реестр НС)" />
    <bpmn:task id="Activity_0ktty50" name="Медицинские&#10;учреждения&#10;(форма 59-НСП/у)" />
    <bpmn:task id="Task_Unions" name="Профсоюзы&#10;(звонки,&#10;письма)" />
    <bpmn:task id="Activity_07soqnp" name="Следственные&#10;органы" />
    <bpmn:task id="Task_SMI" name="СМИ" />
    <bpmn:task id="Task_MChS" name="МЧС&#10;(сводка по email)" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_AsIs">
    <bpmndi:BPMNPlane id="BPMNPlane_AsIs" bpmnElement="Collab_AsIs">
