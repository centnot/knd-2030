<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_NS_ToBe" targetNamespace="http://rostrud.gov.ru/bpmn" exporter="Camunda Modeler" exporterVersion="5.27.0">
  <bpmn:collaboration id="Collab_ToBe">
    <bpmn:participant id="Pool_Employer" name="РАБОТОДАТЕЛЬ" processRef="Proc_Employer" />
    <bpmn:participant id="Pool_SOUT" name="ФГИС СОУТ (ЛК работодателя)" processRef="Proc_SOUT" />
    <bpmn:participant id="Pool_ASUKND" name="АСУ КНД (существующий процесс РНС + новые интеграции)" processRef="Proc_ASUKND" />
    <bpmn:participant id="Pool_External" name="ВНЕШНИЕ СИСТЕМЫ" processRef="Proc_External" />
    <bpmn:messageFlow id="MF_ToSOUT" name="электронное извещение" sourceRef="Task_ENotice" targetRef="Task_SOUTReceive" />
    <bpmn:messageFlow id="MF_SOUTtoASU" name="СМЭВ 3.0 (авто)" sourceRef="Task_SOUTTransfer" targetRef="Evt_FromEmployer" />
    <bpmn:messageFlow id="MF_ASUtoSFR" name="СМЭВ (авто)" sourceRef="Task_ASUtoSFR" targetRef="Task_SFR" />
    <bpmn:messageFlow id="MF_GosKey" name="ЭП через ГосКлюч" sourceRef="Task_SOUTSign" targetRef="Task_GosKey" />
    <bpmn:messageFlow id="MF_Notify" name="уведомления" sourceRef="Task_ASUDashboard" targetRef="Task_GEPS" />
    <bpmn:messageFlow id="MF_MAX" name="уведомления" sourceRef="Task_ASUDashboard" targetRef="Task_MAX" />
    <bpmn:messageFlow id="MF_MChS" name="сводки (e-mail)" sourceRef="Task_MChS" targetRef="Evt_FromExternal" />
    <bpmn:messageFlow id="MF_MedOrg" name="перспектива ЛК" sourceRef="Task_MedOrg" targetRef="Evt_FromExternal" />
    <bpmn:messageFlow id="MF_StatusToEmpl" name="статусы, уведомления" sourceRef="Task_SOUTSign" targetRef="Task_TrackStatus" />
    <bpmn:textAnnotation id="Ann_Auto">
      <bpmn:text>НОВОЕ: Авто-инициация из ФГИС СОУТ
(сейчас — ручной ввод)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Auto" sourceRef="Task_ASUInit" targetRef="Ann_Auto" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Employer" isExecutable="false">
    <bpmn:startEvent id="Start_NS" name="Несчастный&#10;случай" />
    <bpmn:serviceTask id="Task_ENotice" name="Электронное&#10;извещение&#10;(через ФГИС СОУТ)" />
    <bpmn:serviceTask id="Task_CreateComm" name="Приказ о&#10;комиссии&#10;(в ЛК ФГИС СОУТ)" />
    <bpmn:serviceTask id="Task_SignGosKey" name="Подписание&#10;через ГосКлюч&#10;(ЭП всех членов)" />
    <bpmn:serviceTask id="Task_StructAct" name="Акт о расследовании и  Н-1 (структурированный,&#10;электронный)" />
    <bpmn:serviceTask id="Task_TrackStatus" name="Отслеживание&#10;статуса в ЛК&#10;(уведомления:&#10;ГЭПС + MAX)" />
    <bpmn:endEvent id="End_Employer" name="" />
    <bpmn:sequenceFlow id="SF_E1" sourceRef="Start_NS" targetRef="Task_ENotice" />
    <bpmn:sequenceFlow id="SF_E2" sourceRef="Task_ENotice" targetRef="Task_CreateComm" />
    <bpmn:sequenceFlow id="SF_E3" sourceRef="Task_CreateComm" targetRef="Task_SignGosKey" />
    <bpmn:sequenceFlow id="SF_E4" sourceRef="Task_SignGosKey" targetRef="Task_StructAct" />
    <bpmn:sequenceFlow id="SF_E5" sourceRef="Task_StructAct" targetRef="Task_TrackStatus" />
    <bpmn:sequenceFlow id="SF_E6" sourceRef="Task_TrackStatus" targetRef="End_Employer" />
    <bpmn:textAnnotation id="Ann_24h">
      <bpmn:text>Электронное уведомление
(требуется изменение
законодательства)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_24h" sourceRef="Task_ENotice" targetRef="Ann_24h" />
    <bpmn:textAnnotation id="Ann_EP">
      <bpmn:text>ЭП через ГосКлюч для всех
членов комиссии.
Без физического присутствия</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_EP" sourceRef="Task_SignGosKey" targetRef="Ann_EP" />
  </bpmn:process>
  <bpmn:process id="Proc_SOUT" isExecutable="false">
    <bpmn:serviceTask id="Task_SOUTReceive" name="ЛК работодателя:&#10;приём извещения&#10;+ формы комиссии" />
    <bpmn:serviceTask id="Task_SOUTSign" name="ГосКлюч:&#10;подписание ЭП&#10;всеми участниками" />
    <bpmn:serviceTask id="Task_SOUTTransfer" name="Передача данных&#10;в АСУ КНД&#10;(СМЭВ 3.0)" />
    <bpmn:sequenceFlow id="SF_S1" sourceRef="Task_SOUTReceive" targetRef="Task_SOUTSign" />
    <bpmn:sequenceFlow id="SF_S2" sourceRef="Task_SOUTSign" targetRef="Task_SOUTTransfer" />
  </bpmn:process>
  <bpmn:process id="Proc_ASUKND" isExecutable="false">
    <bpmn:startEvent id="Evt_FromEmployer" name="От работодателя&#10;(ФГИС СОУТ → СМЭВ)">
      <bpmn:messageEventDefinition id="MED_Employer" />
    </bpmn:startEvent>
    <bpmn:startEvent id="Evt_FromExternal" name="Из внешних&#10;источников">
      <bpmn:messageEventDefinition id="MED_External" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="GW_MergeIn" name="" />
    <bpmn:sequenceFlow id="SF_FromEmpl" sourceRef="Evt_FromEmployer" targetRef="GW_MergeIn" />
    <bpmn:sequenceFlow id="SF_FromExt" sourceRef="Evt_FromExternal" targetRef="GW_MergeIn" />
    <bpmn:sequenceFlow id="SF_MergeToInit" sourceRef="GW_MergeIn" targetRef="Task_ASUInit" />
    <bpmn:serviceTask id="Task_ASUInit" name="Авто-инициация&#10;процесса РНС&#10;(вместо ручного&#10;ввода)" />
    <bpmn:exclusiveGateway id="GW_Type" name="Тип НС" />
    <bpmn:serviceTask id="Task_Normal" name="Обычное:&#10;фиксация +&#10;контроль" />
    <bpmn:serviceTask id="Task_Additional" name="Доп. расследование:&#10;отказ подписать /&#10;нарушение процедуры" />
    <bpmn:serviceTask id="Task_Hidden" name="Сокрытый НС:&#10;МЧС / СМИ /&#10;больницы" />
    <bpmn:exclusiveGateway id="GW_Merge" name="" />
    <bpmn:serviceTask id="Task_AutoInspector" name="Авто-назначение&#10;инспектора" />
    <bpmn:serviceTask id="Task_ControlSUDK" name="Автоматический контроль&#10;и мониторинг сроков" />
    <bpmn:serviceTask id="Task_ASUDashboard" name="Дашборд НС&#10;для руководителей&#10;+ аналитика" />
    <bpmn:serviceTask id="Task_ASUtoSFR" name="НОВОЕ:&#10;Авто-передача&#10;в СФР&#10;(СМЭВ 3.0)" />
    <bpmn:endEvent id="End_ASU" name="" />
    <bpmn:sequenceFlow id="SF_A1" sourceRef="Task_ASUInit" targetRef="GW_Type" />
    <bpmn:sequenceFlow id="SF_A2" name="обычный" sourceRef="GW_Type" targetRef="Task_Normal" />
    <bpmn:sequenceFlow id="SF_A3" name="доп." sourceRef="GW_Type" targetRef="Task_Additional" />
    <bpmn:sequenceFlow id="SF_A4" name="сокрытый" sourceRef="GW_Type" targetRef="Task_Hidden" />
    <bpmn:sequenceFlow id="SF_A5" sourceRef="Task_Normal" targetRef="GW_Merge" />
    <bpmn:sequenceFlow id="SF_A6" sourceRef="Task_Additional" targetRef="GW_Merge" />
    <bpmn:sequenceFlow id="SF_A7" sourceRef="Task_Hidden" targetRef="GW_Merge" />
    <bpmn:sequenceFlow id="SF_A8" sourceRef="GW_Merge" targetRef="Task_AutoInspector" />
    <bpmn:sequenceFlow id="SF_A9" sourceRef="Task_AutoInspector" targetRef="Task_ControlSUDK" />
    <bpmn:sequenceFlow id="SF_A10" sourceRef="Task_ControlSUDK" targetRef="Task_ASUDashboard" />
    <bpmn:sequenceFlow id="SF_A11" sourceRef="Task_ASUDashboard" targetRef="Task_ASUtoSFR" />
    <bpmn:sequenceFlow id="SF_A12" sourceRef="Task_ASUtoSFR" targetRef="End_ASU" />
    <bpmn:textAnnotation id="Ann_Dashboard">
      <bpmn:text>НОВОЕ: Единая статистика и аналитика
по всем НС + СМЭВ-передача в СФР
(сейчас — ручная передача)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Dashboard" sourceRef="Task_ASUDashboard" targetRef="Ann_Dashboard" />
  </bpmn:process>
  <bpmn:process id="Proc_External" isExecutable="false">
    <bpmn:task id="Task_GEPS" name="ГЭПС → ЕПГУ&#10;(уведомления)" />
    <bpmn:task id="Task_MAX" name="MAX&#10;(мессенджер)" />
    <bpmn:task id="Task_GosKey" name="ГосКлюч&#10;(ЭП членов&#10;комиссии)" />
    <bpmn:task id="Task_MChS" name="МЧС&#10;(сводки)" />
    <bpmn:task id="Task_MedOrg" name="Медучреждения&#10;(перспектива ЛК)" />
    <bpmn:task id="Task_SFR" name="СФР&#10;(реестр НС,&#10;авто)" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ToBe">
